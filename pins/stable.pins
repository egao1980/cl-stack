;;; cl-stack stable channel — curated GHCR pins (bump via PR; see docs/pins.md).
;;; Versions track first-party .asd tags. Tags not yet on GHCR will fail metapackage E2E.
((:pin-format 1)
 (:channel :stable)
 (:registry "https://ghcr.io" :namespace "egao1980/cl-systems")
 (:defaults
  :event-backend "event-backend-libuv"
  :http-backend "http-backend-dexador"
  :http-async-backend "http-backend-async"
  :ws-backend "ws-backend-websocket-driver")
 (:systems
  ;; Core / FFI
  ("alexandria" "1.0.1")
  ("cffi" "0.24.1")
  ("babel" "0.5.0")
  ("bordeaux-threads" "0.9.4")
  ("global-vars" "1.0.0")
  ("trivial-garbage" "0.21")
  ;; Identity / URI / MIME
  ("cl-idna" "0.1.0")
  ("quri" "0.7.1")
  ("cl-mime" "0.5.1")
  ("com.inuoe.jzon" "1.1.4")
  ("yason" "0.8.3")
  ("tomlet" "0.1.0")
  ("json-protocol" "0.2.0")
  ("json-backend-jzon" "0.2.0")
  ("json-backend-yason" "0.2.0")
  ("json-patch" "0.1.0")
  ("yaml-protocol" "latest")
  ("cl-stack-config" "0.1.0")
  ;; CLI / logging / serdes
  ("cli-protocol" "0.1.0")
  ("cli-backend-clingon" "0.1.0")
  ("cli-backend-adopt" "0.1.0")
  ("clingon" "0.7.0")
  ("adopt" "1.3.0")
  ("serdes-protocol" "0.2.1")
  ("sexp-protocol" "0.2.0")
  ("csv-protocol" "0.1.0")
  ("xml-protocol" "0.1.0")
  ("xml-backend-native" "0.1.0")
  ("arrow-protocol" "0.1.0")
  ("io-protocol" "0.1.0")
  ("log-protocol" "0.1.2")
  ("log-backend-log4cl" "0.1.1")
  ("log-backend-vom" "0.1.1")
  ("log4cl" "1.1.4")
  ("vom" "latest")
  ;; Schema
  ("schema-protocol" "0.1.2")
  ("schema-protocol-json" "0.1.1")
  ("schema-protocol-xsd" "0.1.2")
  ("schema-protocol-arrow" "0.1.0")
  ;; Paths / time
  ("cl-stack-pathlib" "0.2.1")
  ("datetime-protocol" "0.1.1")
  ("cl-stack-tzdata" "2026.3.0")
  ("cl-stack-calendars" "0.4.0")
  ("cl-stack-calendar-l10n" "0.1.3")
  ;; Unicode / i18n / l10n
  ("unicode-protocol" "0.1.2")
  ("unicode-backend-cl-unicode" "0.1.0")
  ("unicode-backend-sbcl" "0.1.0")
  ("unicode-backend-icu" "0.1.1")
  ("unicode-backend-icu4j" "0.1.2")
  ("cl-stack-icu" "78.1.3")
  ("cl-stack-icu4j" "78.1.3")
  ("cl-stack-idna" "0.1.0")
  ("i18n-protocol" "0.1.0")
  ("i18n-backend-icu" "0.1.1")
  ("i18n-backend-icu4j" "0.1.1")
  ("l10n-protocol" "0.1.0")
  ("l10n-backend-icu" "0.1.1")
  ("l10n-backend-icu4j" "0.1.2")
  ;; Event
  ("event-protocol" "0.2.0")
  ("event-backend-libuv" "0.1.2")
  ("event-backend-libev" "0.1.3" :platforms (:unix))
  ("event-backend-nio" "0.1.2")
  ("cl-stack-executors" "0.1.0")
  ;; TLS + CE natives
  ("cl-stack-ssl" "3.4.1")
  ("cl-plus-ssl" "latest")
  ("chipz" "0.8")
  ("salza2" "2.1")
  ("cl-stack-brotli" "1.2.0")
  ("cl-stack-zstd" "1.5.7")
  ("cl-stack-snappy" "1.2.2")
  ;; HTTP
  ("http-protocol" "0.3.6")
  ("http-encoding-chipz" "0.1.0")
  ("http-encoding-brotli" "0.1.0")
  ("http-encoding-zstd" "0.1.0")
  ("http-encoding-snappy" "0.1.0")
  ("http-backend-dexador" "0.1.2")
  ("http-backend-async" "0.2.8")
  ("http-backend-winhttp" "0.1.3" :platforms (:windows))
  ("http-backend-java" "0.1.0")
  ("cl-stack-http" "0.1.8")
  ;; HTTP server
  ("http-server-protocol" "0.1.0")
  ("http-server-backend-http2" "0.2.0")
  ("http-server-backend-hunchentoot" "0.1.0")
  ("http-server-backend-woo" "0.1.0" :platforms (:unix))
  ("hunchentoot" "1.3.1")
  ("clack" "2.1.0")
  ("clack-handler-hunchentoot" "2.1.0")
  ("woo" "0.12.0" :platforms (:unix))
  ;; Crypto / secrets / auth
  ("crypto-protocol" "0.2.0")
  ("secrets-protocol" "0.1.0")
  ("crypto-backend-ironclad" "0.2.0")
  ("jose" "0.1.0")
  ("cl-stack-jwt" "0.3.0")
  ("cl-stack-oauth2" "0.1.0")
  ;; SQL
  ("sql-protocol" "0.1.0")
  ("sql-backend-sqlite3" "0.1.0")
  ("sql-backend-postgres" "0.1.0")
  ("sql-query" "0.2.0")
  ("sql-query-sqlite3" "0.2.0")
  ("sql-query-postgres" "0.2.0")
  ("sql-query-csv" "0.1.0")
  ("sql-orm" "0.1.0")
  ;; Process / RPC / SSE
  ("process-protocol" "0.1.0")
  ("process-backend-uiop" "0.1.0")
  ("rpc-protocol" "0.2.0")
  ("rpc-protocol-json" "0.1.0")
  ("rpc-protocol-grpc" "0.1.0")
  ("rpc-backend-inprocess" "0.1.0")
  ("rpc-backend-stdio" "0.1.1")
  ("rpc-backend-http" "0.1.1")
  ("rpc-backend-sse" "0.1.1")
  ("sse-protocol" "0.1.0")
  ("sse-backend-http" "0.1.0")
  ("sse-backend-clack" "0.1.0")
  ;; Protobuf / gRPC
  ("protobuf-protocol" "0.2.0")
  ("protobuf-backend-cl-protobufs" "0.2.0")
  ("grpc-protocol" "0.1.0")
  ("grpc-backend-http2" "0.3.0")
  ("grpc-backend-native" "0.1.0" :platforms (:unix))
  ;; WebSocket
  ("ws-protocol" "0.4.0")
  ("ws-backend-websocket-driver" "0.4.0")
  ;; Telemetry
  ("telemetry-protocol" "0.1.0")
  ("telemetry-backend-otlp" "0.1.0")
  ;; AI wire
  ("mcp-protocol" "0.2.0")
  ("mcp-backend-stdio" "0.1.1")
  ("mcp-backend-streamable-http" "0.2.0")
  ("a2a-protocol" "0.2.0")
  ("a2a-backend-jsonrpc" "0.2.1")
  ("a2a-backend-httpjson" "0.2.0")
  ("a2a-backend-grpc" "0.2.0")
  ("ag-ui-protocol" "0.3.0")
  ("ag-ui-backend-sse" "0.2.1")
  ("ag-ui-backend-protobuf" "0.3.0")
  ("ag-ui-backend-tui" "0.1.0")
  ("llm-protocol" "0.2.0")
  ("llm-protocol-openai" "0.3.0")
  ("llama-cpp" "0.1.5")
  ("llm-backend-llama-cpp" "0.1.2")
  ("ai-agent-protocol" "0.2.0")
  ("blackboard-protocol" "0.1.1")
  ("capability-protocol" "0.2.1")
  ("cl-stack-llm-tui" "0.1.0")))
